# Anthropic Claude API 키
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에_키_입력

# 서버 외부 접근 URL (OAuth 콜백용)
BASE_URL=http://localhost:8000

# YouTube Data API v3
# Google Cloud Console → OAuth 2.0 클라이언트 ID (데스크톱) 생성 후 JSON 파일 저장
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json

# TikTok Content Posting API
# https://developers.tiktok.com 에서 앱 생성 후 발급
TIKTOK_CLIENT_KEY=여기에_클라이언트_키
TIKTOK_CLIENT_SECRET=여기에_클라이언트_시크릿
